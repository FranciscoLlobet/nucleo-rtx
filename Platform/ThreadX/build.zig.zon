.{
    // ThreadX Real-Time Operating System Package for STM32G4
    //
    // This package provides Eclipse's ThreadX RTOS adapted for STM32G4 Cortex-M4
    // microcontrollers with comprehensive build support for embedded applications.
    // Includes core ThreadX kernel, Cortex-M4 optimized port, error checking,
    // and performance monitoring capabilities.
    .name = .threadx,

    // Semantic versioning aligned with Eclipse's ThreadX releases
    .version = "6.1.12",

    // Package fingerprint for security and trust validation
    // Generated by Zig toolchain - modify only when creating new fork
    .fingerprint = 0xf85ce455d7d20efe, // Changing this has security and trust implications.

    // Minimum Zig version requirement for modern build system features
    .minimum_zig_version = "0.14.1",

    // Package dependencies for STM32G4 ecosystem integration
    .dependencies = .{
        // Core STM32 project integration
        .Core = .{
            .path = "../../Core",
        },

        // STM32 Hardware Abstraction Layer
        .stm32_hal = .{
            .path = "../../Drivers/stm32_hal",
        },

        // ARM CMSIS v6 for Cortex-M4 support
        .cmsis_6 = .{
            .path = "../CMSIS_6",
        },
    },

    // Package file inclusion specification
    // Defines which files are included in the package hash and distribution
    .paths = .{
        // Build system files
        "build.zig",
        "build.zig.zon",

        // Zig source files (wrapper/bindings)
        "src",

        // ThreadX complete source tree
        "threadx",

        // License and documentation
        "threadx/LICENSE.txt",
        "threadx/README.md",
        "threadx/SECURITY.md",
        "threadx/CONTRIBUTING.md",
    },
}
