    "version": "0.2.0",
    "configurations": [

        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": "./zig-out/bin/testy.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "external",
            "gdbTarget": "tcp:172.26.176.1:61234",
            "gdbPath": "gdb-multiarch",
            "armToolchainPath": "/usr/bin",
            "overrideRestartCommands": [ "load", "stepi" ],
            "postRestartCommands": [],
        }
    ]
